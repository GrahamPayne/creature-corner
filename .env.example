# Creature Corner shop — environment variables
#
# Copy this file to `.env` for local `wrangler pages dev` testing of the
# Cloudflare Pages Functions in functions/api/. Never commit the real .env.
#
# In production these are set in the Cloudflare Pages dashboard:
# Project → Settings → Environment variables.
#
# See docs/SHOP_SETUP.md for how to obtain each value.

# ---- Supabase ----
# SUPABASE_URL and SUPABASE_ANON_KEY are NOT secret — they're also hardcoded
# into the committed frontend config (src/features/shop/api/config.js),
# since this is a static site with no build step to inject env vars into
# browser code. They're listed here because the server-side Functions
# (checkout, webhook, inventory updates) need them too.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# SUPABASE_SERVICE_ROLE_KEY bypasses Row Level Security entirely.
# Server-side only (Cloudflare Pages Functions). NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Stripe ----
# Publishable key is safe for the browser, but the current checkout flow
# (server creates a Checkout Session, browser redirects to session.url)
# doesn't actually need it client-side. Documented for completeness / in
# case a future change needs Stripe.js directly in the browser.
STRIPE_PUBLISHABLE_KEY=pk_test_...

# Secret key and webhook signing secret are server-side only
# (Cloudflare Pages Functions). NEVER expose to the browser.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ---- Site ----
# Used server-side to build Stripe success_url / cancel_url.
SITE_URL=https://creaturecorner.art
