# Cloudflare Pages response headers.
#
# This is a small, actively-changing static site with no content-hashed
# filenames, so a browser (or intermediate cache) can hold onto a stale copy
# of a page/script after a deploy. `no-cache` (not `no-store`) tells caches
# to always revalidate with the server before reusing a stored response —
# still fast (a 304 when unchanged), but never silently serves old content.
/*.html
  Cache-Control: no-cache

# Header rules match the REQUEST path, not the file actually served — so
# `/*.html` above does NOT cover a clean URL like `/admin` (confirmed
# against Cloudflare's own docs). Every clean-URL page needs its own
# explicit entry here, or it falls back to the platform default and can
# go stale after a deploy even though the JS it loads is already correct.
/
  Cache-Control: no-cache

/shop
  Cache-Control: no-cache

/product
  Cache-Control: no-cache

/product/*
  Cache-Control: no-cache

/admin
  Cache-Control: no-cache

/cart
  Cache-Control: no-cache

/about
  Cache-Control: no-cache

/contact
  Cache-Control: no-cache

/gallery
  Cache-Control: no-cache

/commissions
  Cache-Control: no-cache

/exhibition
  Cache-Control: no-cache

/field-guide
  Cache-Control: no-cache

