{
  "name": "creature-corner",
  "version": "1.0.0",
  "description": "Creature Corner - Handmade creatures, masks, and sci-fi art",
  "private": true,
  "scripts": {
    "start": "npx serve .",
    "preview": "npx serve . -p 3000",
    "fg:extract": "node scripts/extract-field-guide-psd.js",
    "fg:typecheck": "tsc -p jsconfig.json",
    "test:unit": "node --test \"tests/field-guide/unit/*.test.mjs\"",
    "test:e2e": "playwright test",
    "test": "npm run fg:typecheck && npm run test:unit && npm run test:e2e"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.4.0",
    "@playwright/test": "^1.61.1",
    "ag-psd": "^31.0.2",
    "heic-convert": "^2.1.0",
    "sharp": "^0.35.2",
    "three": "^0.185.0",
    "typescript": "^7.0.2"
  }
}
